# Passwort für den Adminbereich unter /admin (in Vercel unter Settings → Environment Variables setzen)
ADMIN_PASSWORD=

# Wird von Vercel automatisch gesetzt, sobald ein Blob-Speicher mit dem Projekt verbunden ist.
# Lokal leer lassen: Dann landen Termine und Flyer im Ordner .data/.
BLOB_READ_WRITE_TOKEN=
